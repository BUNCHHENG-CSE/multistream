# Neon PostgreSQL Connection Strings
# Pooled connection string (used by @neondatabase/serverless in the Next.js runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Direct connection string (used by Drizzle Kit for schema migrations/push)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Better Auth Secret (32+ chars)
# Generate one via: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# Base URL of your app in production (e.g. https://your-domain.com)
BETTER_AUTH_URL="https://tct-multistream.vercel.app"
NEXT_PUBLIC_APP_URL="https://tct-multistream.vercel.app"

# Optional OAuth Provider (GitHub)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional Google OAuth & YouTube Feed Linking (YouTube Data API v3)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
